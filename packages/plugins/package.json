{
  "name": "@cordium/plugins",
  "version": "0.3.0",
  "private": true,
  "description": "Cordium 插件机制：加载器、执行隔离、manifest 校验、依赖解析、目录索引（不含任何具体业务插件）",
  "license": "MIT",
  "author": "Cadttun (https://github.com/cadttun)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadttun/cordium.git",
    "directory": "packages/plugins"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "src",
    "types"
  ],
  "dependencies": {
    "@cordium/kernel": "0.3.0"
  },
  "scripts": {
    "types:emit": "tsc -p tsconfig.emit.json"
  },
  "exports": {
    "./runtime": {
      "types": "./types/runtime.d.mts",
      "default": "./src/runtime.mjs"
    },
    "./ecosystem": {
      "types": "./types/ecosystem.d.mts",
      "default": "./src/ecosystem.mjs"
    },
    "./catalog": {
      "types": "./types/catalog.d.mts",
      "default": "./src/catalog.mjs"
    },
    "./isolation": {
      "types": "./types/isolation.d.mts",
      "default": "./src/isolation.mjs"
    },
    "./loader": {
      "types": "./types/loader.d.mts",
      "default": "./src/loader.mjs"
    },
    "./reload": {
      "types": "./types/reload.d.mts",
      "default": "./src/reload.mjs"
    },
    "./package.json": "./package.json"
  }
}
